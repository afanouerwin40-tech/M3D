+}
+
+/* ---------------------------------------------------------------
+   ACTIVITES (v6) — frais multiples + paiements historises. On reutilise
+   volontairement les composants existants (.card, .chip-row, .btn-chip,
+   .field, .toggle) plutot que d'inventer un nouveau vocabulaire visuel :
+   la mission demande explicitement de rester coherent avec le design deja
+   en place (theme clair/sombre inclus, via les variables --* ci-dessus).
+--------------------------------------------------------------- */
+.activite-stats-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:8px; margin:14px 0; }
+@media (min-width:520px) { .activite-stats-grid { grid-template-columns:repeat(4, 1fr); } }
+.activite-stat { background:var(--surface-2); border-radius:12px; padding:10px 12px; }
+.activite-stat .lbl { font-size:11px; color:var(--text-3); font-weight:600; text-transform:uppercase; letter-spacing:.02em; }
+.activite-stat .val { font-family:var(--font-display); font-size:17px; font-weight:700; margin-top:3px; line-height:1.1; }
+
+/* Statuts de paiement d'un participant -- non_paye reutilise .badge-no,
+   paye reutilise .badge-yes (deja utilises ailleurs dans l'app), seuls
+   "partiel" et "surpaye" sont de nouvelles variantes. */
+.badge-partiel { background:var(--bg-warning); color:var(--warning); }
+.badge-surpaye { background:var(--bg-purple); color:var(--purple); }
+
+.frais-chip { display:flex; align-items:center; justify-content:space-between; padding:9px 4px; border-bottom:1px solid var(--border); gap:10px; }
+.frais-chip:last-child { border-bottom:none; }
+.frais-chip .name { font-size:14.5px; font-weight:600; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.frais-chip .amount { font-size:13.5px; color:var(--text-2); font-weight:600; white-space:nowrap; }
+.frais-chip-actions { display:flex; gap:12px; flex-shrink:0; }
+
+.participant-actions { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
+
+/* Formulaire des participants : chaque membre de l'association (actif ou
+   inactif) est une ligne a cocher, plutot qu'une recherche membre par
+   membre. Cocher un frais coche implicitement la participation. */
+.participant-form-row { padding:12px 4px; border-bottom:1px solid var(--border); }
+.participant-form-row:last-child { border-bottom:none; }
+.participe-check { display:flex; align-items:center; gap:9px; cursor:pointer; }
+.participe-check input[type="checkbox"] { width:19px; height:19px; flex-shrink:0; }
+.participe-check .name { font-size:15px; font-weight:600; }
+.tag-inactif { font-size:11px; font-weight:600; color:var(--text-3); background:var(--surface-2); border-radius:6px; padding:2px 6px; }
+.frais-inline-row { display:flex; flex-wrap:wrap; gap:10px 16px; margin:8px 0 2px 28px; }
+.frais-inline { display:flex; align-items:center; gap:6px; font-size:13.5px; cursor:pointer; }
+.frais-inline input[type="checkbox"] { width:16px; height:16px; }
+.frais-inline .amount { color:var(--text-3); }
+
+.paiement-histo-item { display:flex; justify-content:space-between; align-items:baseline; padding:9px 0; border-bottom:1px solid var(--border); font-size:14px; gap:10px; }
+.paiement-histo-item:last-child { border-bottom:none; }
+.paiement-histo-item .montant { font-weight:700; color:var(--success); flex-shrink:0; }
+.paiement-histo-item .meta { color:var(--text-3); font-size:12.5px; }
+
+
+.cloture-banner { background:var(--bg-warning); color:var(--warning); border-radius:12px; padding:10px 12px; font-size:13.5px; font-weight:600; margin:10px 0; display:flex; align-items:center; justify-content:space-between; gap:8px; }
